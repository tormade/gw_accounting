{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Getraenkeladen Tool",
            "type": "debugpy",
            "request": "launch",
            "module": "getraenkeladen_tool",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "QT_QPA_PLATFORM_PLUGIN_PATH": "${workspaceFolder}/.venv/lib/python3.12/site-packages/PySide6/Qt/plugins/platforms"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
