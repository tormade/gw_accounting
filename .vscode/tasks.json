{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Getraenkeladen Tool starten",
            "type": "shell",
            "command": "PYTHONPATH=src QT_QPA_PLATFORM_PLUGIN_PATH=.venv/lib/python3.12/site-packages/PySide6/Qt/plugins/platforms .venv/bin/python -m getraenkeladen_tool",
